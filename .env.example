# Copy to .env.local for local development.
# Required for the app to call the model at all:
ANTHROPIC_API_KEY=sk-ant-...

# NODE_ENV is set automatically by Next.js (development/production) — not
# something you set by hand here. Included as a comment only because
# app/api/audit-chat/route.ts checks it to gate the dev-only ?sabotage=
# testing switch off in production.
