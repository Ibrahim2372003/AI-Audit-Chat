# Copy to .env.local for local development. Placeholders only: never commit
# real keys. These are read on the server only (no NEXT_PUBLIC_ prefix).

# Which provider /api/audit-chat uses: "google" (default) or "anthropic".
AI_PROVIDER=google

# --- Google Gemini (default) -------------------------------------------------
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=api ai

# REQUIRED. Use a model ID that appears in YOUR AI Studio model list and has
# free-tier quota on your account. The value below is only a starting point
# taken from Google's public pricing page; free-tier access and quotas change,
# so verify it in AI Studio before relying on it.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic (optional; requires prepaid API credits) -------------------------
# To use it, set AI_PROVIDER=anthropic and fill in the key below.
ANTHROPIC_API_KEY=your-anthropic-key
# Optional; defaults to claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# NODE_ENV is set automatically by Next.js (development/production), not by
# hand. app/api/audit-chat/route.ts checks it to gate the dev-only
# ?sabotage= testing switch off in production.
